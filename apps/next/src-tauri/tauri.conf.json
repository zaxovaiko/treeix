{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treeix Next",
  "version": "0.1.0",
  "identifier": "com.dyvertex.treeix.next",
  "build": {
    "beforeDevCommand": "sh scripts/build-ptyd.sh debug && bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "sh scripts/build-ptyd.sh && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Treeix",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundThrottling": "disabled",
        "trafficLightPosition": {
          "x": 14,
          "y": 10
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "files": {
        "Library/LaunchAgents/com.dyvertex.treeix.next.ptyd.plist": "./LaunchAgents/com.dyvertex.treeix.next.ptyd.plist"
      }
    },
    "externalBin": [
      "binaries/treeix-ptyd"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zaxovaiko/treeix/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY_SEE_DOCS_NEXT_UPDATER_MD",
      "requireSignedVersion": true
    }
  }
}
