{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treeix",
  "version": "../package.json",
  "identifier": "com.dyvertex.treeix",
  "build": {
    "beforeDevCommand": "sh scripts/build-ptyd.sh debug && sh scripts/build-voice.sh debug && bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "sh scripts/build-ptyd.sh && sh scripts/build-voice.sh && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Treeix",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundThrottling": "disabled",
        "trafficLightPosition": {
          "x": 14,
          "y": 19
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "files": {
        "Library/LaunchAgents/com.dyvertex.treeix.ptyd.plist": "./LaunchAgents/com.dyvertex.treeix.ptyd.plist"
      }
    },
    "externalBin": [
      "binaries/treeix-ptyd"
    ],
    "fileAssociations": [
      {
        "name": "Text document",
        "description": "Any text or source file, from Open With",
        "ext": ["txt", "md", "json", "yaml", "yml", "xml", "py", "rs", "go", "sh", "css", "html", "sql"],
        "contentTypes": ["public.plain-text", "public.source-code", "public.script", "public.json", "public.xml", "public.yaml", "net.daringfireball.markdown"],
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": "Source code",
        "description": "Source files macOS has no text type for",
        "ext": ["ts", "tsx", "mts", "cts", "jsx", "mjs", "cjs", "graphql", "gql", "prisma", "vue", "svelte", "toml", "env", "lua", "mdx", "kt", "dockerfile"],
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zaxovaiko/treeix/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNzk4NDM0QTRDREVENUYKUldSZjdjMmtOSVI1c3UxYW83MzYyYnRhS2JOSjZIT0dTTkNJdEhWRjhOdHhtajE2TWFvQmRjK3gK",
      "requireSignedVersion": true
    }
  }
}
